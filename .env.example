# opencode2api — mẫu biến môi trường cho `docker compose`
# Cách dùng:
#   cp .env.example .env   (rồi sửa .env cho phù hợp)
#   docker compose up -d --build
# Compose tự đọc file `.env` cùng thư mục — không cần khai báo env_file.
#
# LƯU Ý QUAN TRỌNG:
# - Các biến O2A_* bên dưới CHỈ có tác dụng khi chạy container
#   (entrypoint merge chúng vào /var/lib/opencode2api/config.json MỖI lần start).
# - Không cần file config.json trên host: lần start đầu entrypoint seed từ
#   config.example.json có sẵn trong image rồi mới áp O2A_*.
# - Chạy binary trực tiếp (./opencode2api -config config.json) vẫn dùng config.json,
#   O2A_* không có tác dụng.
# - Tất cả O2A_* đều optional: để trống/rỗng = không override (giữ giá trị trong JSON).
# - Biến _FILE ưu tiên hơn biến thường (ví dụ O2A_ZEN_KEYS_FILE thắng O2A_ZEN_KEYS).
# - File này KHÔNG chứa secret thật — chỉ placeholder. File `.env` thật phải giữ kín,
#   không commit (đã có trong .gitignore).

# ---------------------------------------------------------------------------
# Port / version / TZ (biến compose có sẵn, giữ nguyên hành vi cũ)
# ---------------------------------------------------------------------------
# Image tag GHCR (khi dùng `image:` thay vì `build:`). Pin tag release để cố định version.
OPENCODE2API_VERSION=latest
# Host port map tới container 8080 (API) và 8081 (WebUI).
OPENCODE2API_PORT=8909
OPENCODE2API_WEBUI_PORT=8901
# Override listen container (để trống = dùng config.json).
# Ví dụ: OPENCODE2API_LISTEN=0.0.0.0:8080
OPENCODE2API_LISTEN=
OPENCODE2API_WEBUI_LISTEN=
# Timezone container.
TZ=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------------
# Secrets: keys / password (comma-separated cho keys)
# ---------------------------------------------------------------------------
# Local API key để client gọi gateway (http header Authorization: Bearer ...).
# Ví dụ: O2A_SERVER_KEYS=sk-local-aaa111,sk-local-bbb222
O2A_SERVER_KEYS=
# Đọc server keys từ file (ưu tiên hơn O2A_SERVER_KEYS). Giá trị là PATH TRONG
# CONTAINER, cần mount volume/secret tương ứng. Nội dung file: comma-separated
# hoặc mỗi key một dòng.
# Ví dụ: O2A_SERVER_KEYS_FILE=/run/secrets/server_keys
O2A_SERVER_KEYS_FILE=
# Upstream Zen keys (comma-separated).
# Ví dụ: O2A_ZEN_KEYS=zen-key-aaa111,zen-key-bbb222
O2A_ZEN_KEYS=
# Ví dụ: O2A_ZEN_KEYS_FILE=/run/secrets/zen_keys
O2A_ZEN_KEYS_FILE=
# Upstream Go keys (comma-separated).
# Ví dụ: O2A_GO_KEYS=go-key-aaa111,go-key-bbb222
O2A_GO_KEYS=
# Ví dụ: O2A_GO_KEYS_FILE=/run/secrets/go_keys
O2A_GO_KEYS_FILE=
# Mật khẩu bootstrap WebUI (tối thiểu 10 ký tự). Lần start sẽ hash rồi xoá plaintext.
# Ví dụ: O2A_WEBUI_PASSWORD=change-me-min-10-chars
O2A_WEBUI_PASSWORD=
# Đọc password WebUI từ file (ưu tiên hơn O2A_WEBUI_PASSWORD, ví dụ docker secret).
# Ví dụ: O2A_WEBUI_PASSWORD_FILE=/run/secrets/webui_password
O2A_WEBUI_PASSWORD_FILE=

# ---------------------------------------------------------------------------
# Upstream / proxy
# ---------------------------------------------------------------------------
# Anonymous Zen lane: true/false. true = cho phép lane public không cần key.
O2A_ANONYMOUS=
# Override upstream URL (để trống = dùng config.json).
# Ví dụ: O2A_UPSTREAM_ZEN=https://opencode.ai/zen
O2A_UPSTREAM_ZEN=
# Ví dụ: O2A_UPSTREAM_GO=https://opencode.ai/zen/go
O2A_UPSTREAM_GO=
# Upstream cho lane anonymous (khi O2A_ANONYMOUS=true).
# Ví dụ: O2A_UPSTREAM_ANONYMOUS=https://opencode.ai/inference
O2A_UPSTREAM_ANONYMOUS=
# Danh sách proxy inline, comma-separated. Mỗi entry: direct, http(s)://, socks5(h)://.
# Ví dụ: O2A_PROXIES=direct,http://user:pass@127.0.0.1:7890,socks5://127.0.0.1:1080
O2A_PROXIES=
# Đọc proxies từ file (ưu tiên hơn O2A_PROXIES): mỗi dòng một entry, hỗ trợ
# comment (#, ;, //) và dòng trống. PATH TRONG CONTAINER, cần mount tương ứng.
# Ví dụ: O2A_PROXIES_FILE=/run/config/proxies.txt
O2A_PROXIES_FILE=
# Đường dẫn proxyfile ghi vào config (container phải đọc được path này).
# Ví dụ: O2A_PROXYFILE=/var/lib/opencode2api/proxies.txt
O2A_PROXYFILE=

# ---------------------------------------------------------------------------
# Runtime: retry / models / log / prefer / reasoning / listen API
# ---------------------------------------------------------------------------
# Số attempt mỗi authenticated tier (số nguyên, ví dụ 3).
O2A_RETRY_MAX_ATTEMPTS=
# Tổng timeout inference tính bằng giây (ví dụ 300).
O2A_RETRY_TIMEOUT_SECONDS=
# Chu kỳ refresh models tính bằng giây, tối thiểu 1 (ví dụ 300).
O2A_MODELS_REFRESH_SECONDS=
# Alias tên model: JSON object {"tên-client":"model-thật"}. Client gửi tên trái,
# server route tới model phải, và response luôn trả lại tên client đã gửi.
# Giá trị phải là JSON object hợp lệ, nếu không entrypoint sẽ bỏ qua và cảnh báo.
# Ví dụ: O2A_MODEL_ALIASES={"muse-spark-1.3":"muse-spark-1.3-contributor-free"}
O2A_MODEL_ALIASES=
# Ghi đè protocol của từng model: JSON object {"tên-model":"chat"|"responses"}.
# Model không khai báo sẽ dùng protocol mặc định của app.
# Ví dụ: O2A_MODELS_PROTOCOLS={"custom-model":"chat"}
O2A_MODELS_PROTOCOLS=
# Chỉ expose và route model miễn phí, kể cả khi có Zen/Go Key (true/false).
# Model trả phí sẽ bị ẩn khỏi /v1/models và request tới nó trả lỗi.
O2A_MODELS_FREE_ONLY=
# Log level: debug/info/warn/error.
O2A_LOG_LEVEL=
# Số dòng log giữ trong ring buffer (số nguyên, ví dụ 2000).
O2A_LOGGING_RING_SIZE=
# Ghi nguyên request body vào log để debug (true/false; bật sẽ lộ nội dung prompt).
O2A_LOGGING_DUMP_REQUEST_BODIES=
# Tier ưu tiên: go hoặc zen.
O2A_PREFER=
# Thinking level mặc định: minimal/low/medium/high/xhigh/max/none (để trống = tắt).
O2A_REASONING_EFFORT=
# Thinking level riêng cho từng model: JSON object {"tên-model":"high"|"max"|...}.
# Model không có trong object dùng O2A_REASONING_EFFORT.
# Ví dụ: O2A_REASONING_EFFORT_BY_MODEL={"claude-opus-5":"max"}
O2A_REASONING_EFFORT_BY_MODEL=
# Override API listen ghi vào config (ví dụ 0.0.0.0:8080). Đổi qua env cần
# recreate container (không chỉ restart process).
O2A_LISTEN=

# ---------------------------------------------------------------------------
# Performance: pool kết nối HTTP + timeout (tất cả là số nguyên)
# ---------------------------------------------------------------------------
# Tổng số idle connection giữ trong pool (ví dụ 2048).
O2A_PERFORMANCE_MAX_IDLE_CONNS=
# Idle connection tối đa cho mỗi host (ví dụ 256).
O2A_PERFORMANCE_MAX_IDLE_CONNS_PER_HOST=
# Tổng connection tối đa cho mỗi host; 0 = không giới hạn (ví dụ 0).
O2A_PERFORMANCE_MAX_CONNS_PER_HOST=
# Thời gian giữ idle connection, tính bằng giây (ví dụ 120).
O2A_PERFORMANCE_IDLE_CONN_TIMEOUT_SECONDS=
# Timeout thiết lập kết nối TCP, tính bằng giây (ví dụ 5).
O2A_PERFORMANCE_CONNECT_TIMEOUT_SECONDS=
# Thời gian cooldown sau khi một upstream lỗi, tính bằng giây (ví dụ 15).
O2A_PERFORMANCE_FAILURE_COOLDOWN_SECONDS=
# Timeout mỗi attempt inference, tính bằng giây; 0 = không timeout (ví dụ 0).
O2A_PERFORMANCE_ATTEMPT_TIMEOUT_SECONDS=
# Timeout chờ event đầu tiên của stream, tính bằng giây; 0 = không timeout (ví dụ 0).
O2A_PERFORMANCE_FIRST_EVENT_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# WebUI
# ---------------------------------------------------------------------------
# Bật/tắt WebUI: true/false.
O2A_WEBUI_ENABLED=
# Username quản trị WebUI (ví dụ admin).
O2A_WEBUI_USERNAME=
# Override WebUI listen ghi vào config (ví dụ 0.0.0.0:8081). Đổi qua env cần
# recreate container.
O2A_WEBUI_LISTEN=
# Thời gian sống của session WebUI, tính bằng phút (số nguyên, ví dụ 720).
O2A_WEBUI_SESSION_TTL_MINUTES=

# ---------------------------------------------------------------------------
# Rotation: sota/sweet order (comma-separated) + alias + first_output (giây)
# ---------------------------------------------------------------------------
# Tên model ảo mà client dùng để gọi nhóm SOTA (mặc định sota).
# Ví dụ: O2A_SOTA_ALIAS=sota
O2A_SOTA_ALIAS=
# Thứ tự model trong nhóm SOTA, comma-separated. PHẢI đủ đúng 5 model SOTA,
# nếu thiếu/thừa app sẽ fail lúc start khi validate.
# Ví dụ: O2A_SOTA_ORDER=deepseek-v4.1-flash,glm-5.3,grok-4.6,kimi-k3,qwen3.8-max
O2A_SOTA_ORDER=
# Tên model ảo mà client dùng để gọi nhóm sweet (mặc định sweet).
# Ví dụ: O2A_SWEET_ALIAS=sweet
O2A_SWEET_ALIAS=
# Thứ tự model nhóm sweet, comma-separated (để trống = giữ nguyên JSON).
# Ví dụ: O2A_SWEET_ORDER=fast-a,fast-b
O2A_SWEET_ORDER=
# Timeout first output rotation tính bằng giây (1-300; để trống = giữ JSON).
O2A_FIRST_OUTPUT_SECONDS=
